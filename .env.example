# ─── LLM Backend ──────────────────────────────────────────────────────────────
# Options: "ollama" (default, local) or "groq" (external API)
LLM_BACKEND=ollama

# Ollama settings (only used when LLM_BACKEND=ollama)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# Groq settings (only used when LLM_BACKEND=groq)
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# Gemini (only for vision_intake.py — optional, not needed for core pipeline)
# GEMINI_API_KEY=your_key_here
